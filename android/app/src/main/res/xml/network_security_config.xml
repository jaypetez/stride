<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only: the app talks to Garmin (and Anthropic if the coach is on), never over cleartext (SEC-003). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
