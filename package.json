{
  "name": "stride",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "description": "Your Strava agentic coach — a local-first, open-source AI running coach.",
  "license": "Apache-2.0",
  "author": "Jayson Petersen and Stride contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaypetez/stride.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts --noEmit",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test": "turbo run test && vitest run",
    "test:watch": "turbo watch test",
    "test:affected": "turbo run test --affected",
    "coverage": "turbo run test -- --coverage && vitest run --coverage",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm build && pnpm verify",
    "verify": "node scripts/smoke.mjs",
    "check:android": "node scripts/check-android.mjs",
    "check:all": "pnpm check && pnpm check:android",
    "factory": "tsx tools/factory/src/cli.ts",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version": "changeset version && node scripts/android-version.mjs",
    "release": "changeset publish",
    "prepare": "husky",
    "science:golden": "tsx scripts/science-golden.mts"
  },
  "lint-staged": {
    "*.{ts,mts,tsx,js,mjs,json}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild@0.27": "^0.28.1",
      "body-parser@2": "^2.4.0",
      "fast-uri": "^3.1.6",
      "launch-editor": "^2.14.2",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2"
    }
  }
}
